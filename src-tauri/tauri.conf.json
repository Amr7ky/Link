{
  "productName": "Link",
  "version": "1.0.1",
  "identifier": "com.link.app",
  "build": {
    "beforeDevCommand": "node ./node_modules/vite/bin/vite.js --port 5173 --strictPort",
    "beforeBuildCommand": "node ./node_modules/vite/bin/vite.js build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Link",
        "backgroundColor": "#0B0B0D",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: http:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "useLocalToolsDir": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
